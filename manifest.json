{
  "manifest_version": 3,
  "name": "Nullsanz TikTok Studio — Patcher 4.0 Pro, SoundSafe & CoverSafe",
  "version": "4.0.0",
  "description": "Nullsanz TikTok Studio v4.0 Pro (Dual Engine 4.0 Direct sl-sr & 4.0 Pro Offline FFmpeg WASM + CoverSafe & SoundSafe Anti-Softban) by nullsanz / null.cloud",
  "minimum_chrome_version": "116",
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://studio.tiktok.com/*",
    "https://*.tiktok.com/*",
    "*://*.tiktok.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nullsanz TikTok Studio v4.0 Pro",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://studio.tiktok.com/*",
        "https://*.tiktok.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "orion-compat.js",
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://studio.tiktok.com/*",
        "https://*.tiktok.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "orion-compat.js",
        "nullsanz-mp4-core.js",
        "nullsanz-slsr-engine.js",
        "nullsanz-engine.js",
        "processor.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "processor.html",
        "processor.js",
        "patcher.html",
        "patcher.js",
        "nullsanz-mp4-core.js",
        "nullsanz-slsr-engine.js",
        "nullsanz-pro-core.js",
        "nullsanz-engine.js",
        "ffmpeg-worker.js",
        "ffmpeg-core.js",
        "ffmpeg-core.wasm.gz",
        "orion-compat.js",
        "icon16.png",
        "icon32.png",
        "icon48.png",
        "icon128.png",
        "icon256.png",
        "icon512.png",
        "page-hook.js",
        "nullsanz-upload-banner.jpg",
        "nullsanz-logo-master.png",
        "nullsanz-logo-original.png"
      ],
      "matches": [
        "https://www.tiktok.com/*",
        "https://studio.tiktok.com/*",
        "*://*.tiktok.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png",
    "256": "icon256.png",
    "512": "icon512.png"
  }
}
